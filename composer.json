{
    "name": "fof/categories",
    "description": "Traditional Category Layout for Flarum",
    "keywords": [
        "flarum"
    ],
    "type": "flarum-extension",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/FriendsOfFlarum/categories/issues",
        "source": "https://github.com/FriendsOfFlarum/categories"
    },
    "require": {
        "php": "^8.1",
        "flarum/core": "^1.8.0",
        "flarum/tags": "^1.8.0"
    },
    "replace": {
        "askvortsov/flarum-categories": "*"
    },
    "authors": [
        {
            "name": "FriendsOfFlarum",
            "homepage": "https://friendsofflarum.org"
        }
    ],
    "autoload": {
        "psr-4": {
            "FoF\\Categories\\": "src/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "FoF Categories",
            "category": "theme",
            "icon": {
                "name": "fas fa-th-list",
                "backgroundColor": "#e74c3c",
                "color": "#fff"
            }
        },
        "flarum-cli": {
            "modules": {
                "admin": true,
                "forum": true,
                "js": true,
                "jsCommon": false,
                "css": true,
                "locale": true,
                "gitConf": true,
                "githubActions": true,
                "prettier": true,
                "typescript": false,
                "bundlewatch": false,
                "backendTesting": false,
                "editorConfig": true,
                "styleci": true
            }
        }
    }
}
