{
    "name": "fof/categories",
    "description": "Traditional Category Layout for Flarum",
    "keywords": [
        "flarum"
    ],
    "type": "flarum-extension",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/FriendsOfFlarum/categories/issues",
        "source": "https://github.com/FriendsOfFlarum/categories",
        "forum": "https://discuss.flarum.org/d/38778-friendsofflarum-categories"
    },
    "homepage": "https://friendsofflarum.org",
    "funding": [
        {
            "type": "website",
            "url": "https://opencollective.com/fof/donate"
        }
    ],
    "require": {
        "flarum/core": "^2.0.0",
        "flarum/tags": "^2.0.0"
    },
    "require-dev": {
        "flarum/phpstan": "^2.0.0",
        "flarum/flags": "^2.0.0",
        "flarum/audit": "^2.0.0",
        "flarum/realtime": "^2.0.0",
        "fof/forum-widgets-core": "^2.0.2",
        "flarum/gdpr": "^2.0.1",
        "flarum/testing": "^2.0"
    },
    "replace": {
        "askvortsov/flarum-categories": "*"
    },
    "authors": [
        {
            "name": "FriendsOfFlarum",
            "homepage": "https://friendsofflarum.org"
        }
    ],
    "autoload": {
        "psr-4": {
            "FoF\\Categories\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FoF\\Categories\\Tests\\": "tests/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "FoF Categories",
            "optional-dependencies": [
                "flarum/realtime",
                "fof/forum-widgets-core"
            ],
            "category": "theme",
            "icon": {
                "name": "fas fa-th-list",
                "backgroundColor": "#e74c3c",
                "color": "#fff"
            }
        },
        "flarum-cli": {
            "modules": {
                "admin": true,
                "forum": true,
                "js": true,
                "jsCommon": false,
                "css": true,
                "locale": true,
                "gitConf": true,
                "githubActions": true,
                "prettier": true,
                "typescript": false,
                "bundlewatch": false,
                "backendTesting": false,
                "editorConfig": true,
                "styleci": true
            }
        }
    },
    "scripts": {
        "analyse:phpstan": "phpstan analyse",
        "clear-cache:phpstan": "phpstan clear-result-cache",
        "test": [
            "@test:integration"
        ],
        "test:integration": "phpunit -c tests/phpunit.integration.xml",
        "test:integration:filter": "phpunit -c tests/phpunit.integration.xml --filter",
        "test:setup": "@php tests/integration/setup.php"
    },
    "scripts-descriptions": {
        "analyse:phpstan": "Run static analysis",
        "test": "Runs all tests.",
        "test:integration": "Runs all integration tests.",
        "test:integration:filter": "Runs integration tests whose name matches: composer test:integration:filter -- ClassName",
        "test:setup": "Sets up a database for use with integration tests. Execute this only once."
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
